      {
        "id": 5,
        "title": "Production Readiness",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "merid_production_readiness_status",
            "legendFormat": "Production Ready"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": {
                    "color": "red",
                    "text": "BLOCKED"
                  }
                },
                "type": "value"
              },
              {
                "options": {
                  "1": {
                    "color": "green",
                    "text": "READY"
                  }
                },
                "type": "value"
              }
            ]
          }
        }
      },
      {
        "id": 6,
        "title": "Gate Health Score",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 16
        },
        "targets": [
          {
            "expr": "(merid_technical_readiness_gate_status + merid_operational_readiness_gate_status + merid_cohort_gate_status + merid_stress_test_gate_status) / 4 * 100",
            "legendFormat": "Gate Score"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 75
                },
                {
                  "color": "yellow",
                  "value": 90
                },
                {
                  "color": "green",
                  "value": 100
                }
              ]
            }
          }
        }
      }
    ],
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "refresh": "60s"
  }
