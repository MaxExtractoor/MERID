{
  "dashboard": {
    "id": null,
    "title": "MERID Governance Gates",
    "tags": [
      "merid",
      "governance",
      "gates"
    ],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Technical Readiness Gate",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "merid_technical_readiness_gate_status",
            "legendFormat": "Technical Gate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": {
                    "color": "red",
                    "text": "FAIL"
                  }
                },
                "type": "value"
              },
              {
                "options": {
                  "1": {
                    "color": "green",
                    "text": "PASS"
                  }
                },
                "type": "value"
              }
            ]
          }
        }
      },
      {
