# MERID Swarm Configuration Example
# Copy this to .env and configure for your deployment

# =============================================================================
# TRADING MODE CONFIGURATION
# =============================================================================

# Primary mode: simulation | paper | live
# - simulation: Local sim engine, no external calls
# - paper: Broker paper APIs, real data but no real money
# - live: Real trading (REQUIRES explicit authorization code changes)
RUN_MODE=simulation

# Live mode safety lock (must be explicitly true for live trading)
LIVE_MODE_AUTHORIZED=false

# Paper trading broker (if RUN_MODE=paper)
# Options: alpaca | ibkr | coinbase | kalshi
PAPER_BROKER=Kalshi

# =============================================================================
# SWARM CONSENSUS SETTINGS
# =============================================================================

# Minimum agents required to form consensus
MIN_AGENTS_PER_TRADE=3

# Maximum age of market state before considered stale (seconds)
MAX_STATE_AGE_SECONDS=30

# Consensus threshold (0.0-1.0, default 0.65 = 65% agreement)
CONSENSUS_THRESHOLD=0.65

# Consensus timeout (seconds before round expires)
CONSENSUS_TIMEOUT_SECONDS=60

# =============================================================================
# AGENT HEALTH MONITORING
# =============================================================================

# Heartbeat interval for all agents (seconds)
HEARTBEAT_INTERVAL_SECONDS=30

# Liveness timeout before agent considered offline (seconds)
LIVENESS_TIMEOUT_SECONDS=60

# Watchdog check interval (seconds)
WATCHDOG_CHECK_INTERVAL_SECONDS=30

# =============================================================================
# REHEARSAL SETTINGS
# =============================================================================

# Default rehearsal duration (seconds)
REHEARSAL_DURATION_SECONDS=60

# Expected opinions per minute (for rate validation)
EXPECTED_OPINIONS_PER_MINUTE=10

# Expected consensus per minute (for rate validation)
EXPECTED_CONSENSUS_PER_MINUTE=2

# Enable event log capture during rehearsals
REHEARSAL_LOG_CAPTURE_ENABLED=true

# Log directory for rehearsal captures
REHEARSAL_LOG_DIR=logs

# =============================================================================
# ORDER ROUTING LIMITS
# =============================================================================

# Maximum order size in USD
MAX_ORDER_SIZE_USD=1.50

# Maximum orders per day
MAX_DAILY_ORDERS=100

# Simulation slippage (basis points)
SIM_SLIPPAGE_BPS=5.0

# Simulation commission (basis points)
SIM_COMMISSION_BPS=2.0

# Simulation fill delay (milliseconds)
SIM_FILL_DELAY_MS=100.0

# =============================================================================
# TELEMETRY & MONITORING
# =============================================================================

# Prometheus metrics endpoint enabled
PROMETHEUS_METRICS_ENABLED=true

# Prometheus scrape port
PROMETHEUS_PORT=9090

# Metrics export interval (seconds)
METRICS_EXPORT_INTERVAL_SECONDS=15

# WebSocket event broadcast enabled
WEBSOCKET_EVENTS_ENABLED=true

# Swarm telemetry broadcast interval (seconds)
SWARM_TELEMETRY_INTERVAL_SECONDS=5

# =============================================================================
# WATCHDOG THRESHOLDS
# =============================================================================

# Max disagreement ratio before watchdog alert (0.0-1.0)
MAX_DISAGREEMENT_RATIO=0.4

# Min agents for consensus health (absolute number)
MIN_CONSENSUS_AGENTS=3

# Max opinion staleness before alert (seconds)
MAX_OPINION_STALENESS_SECONDS=10

# Max consensus lag before alert (seconds)
MAX_CONSENSUS_LAG_SECONDS=5

# =============================================================================
# DEPLOYMENT METADATA
# =============================================================================

# Swarm readiness checklist version
SWARM_CHECKLIST_VERSION=1.0.0

# Deployment environment
DEPLOYMENT_ENV=development

# Enable debug logging for swarm events
SWARM_DEBUG_LOGGING=true
