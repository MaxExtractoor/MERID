# MERID paper/shadow soak overrides.
# Load this AFTER the base .env so these values take precedence.
# Do not place real API keys in this file; set Kalshi credentials and any
# optional direct CF Benchmarks key in the process environment.

MERID_CFB_RTI_ADAPTER=true
MERID_ALLOW_LIVE_TRADES=false
MERID_PM_TRADING_MODE=paper
MERID_CFB_RTI_SHADOW_TELEMETRY=1
MERID_ENABLE_LEGACY_095_SENTINEL_TRAP=1

# Primary RTI source is the Kalshi authenticated ``cfbenchmarks_value`` WebSocket.
# Use ``direct`` to force the direct CF Benchmarks REST key, or ``both`` to allow
# that key as a fallback.  Kalshi credentials are taken from the base .env.
MERID_CFB_RTI_SOURCE=kalshi_ws

# PostgreSQL is mandatory for paper/shadow soak so the fills ledger and
# portfolio event log cannot silently fall back to SQLite and produce an
# incomplete audit record.
MERID_POSTGRES_REQUIRED=true

# Optional: direct CF Benchmarks REST key (process-only, never commit).
# Only used when MERID_CFB_RTI_SOURCE=direct or both.
# $env:MERID_CFB_RTI_API_KEY = "..."
