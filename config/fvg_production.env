# ═══════════════════════════════════════════════════════════════════════════════
# FVG (Fair Value Gap) Production Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# 
# This file contains production-ready environment variables for the FVG system.
# Source this file before starting the MERID Kalshi trading system:
#   source config/fvg_production.env  (Linux/Mac)
#   config/fvg_production.env         (Windows - use script)
#
# All values calibrated for live Kalshi crypto prediction market trading.
# ═══════════════════════════════════════════════════════════════════════════════

# =============================================================================
# RISK PROFILE (Kalshi Crypto 15m)
# =============================================================================
# Activates config-only risk model for BTC/ETH/SOL/XRP/DOGE 15m trading
# When active, all risk caps are derived from kalshi_crypto_15m.yaml profile
# instead of bankroll-derived computation (balance independence invariant)
MERID_PROFILE=kalshi_crypto_15m_v2

# =============================================================================
# FVG CORE ENABLEMENT
# =============================================================================
MERID_FVG_ENABLED=true
MERID_FVG_LOG_LEVEL=INFO

# =============================================================================
# FVG DETECTION PARAMETERS (Production Calibrated)
# =============================================================================

# Window size: Number of candles to maintain for FVG detection
# Higher = more historical gaps tracked, more memory usage
# Production: 20 candles balances detection sensitivity with memory
MERID_FVG_WINDOW_SIZE=20

# Minimum gap size in cents to qualify as an FVG
# Production: 2.0 cents minimum (covers typical Kalshi spread + micro-edge)
MERID_FVG_MIN_GAP_CENTS=2.0

# Fill threshold: Price must enter gap by this amount to mark as filled
# Production: 5.0 cents ensures genuine fills vs noise
MERID_FVG_FILL_THRESHOLD=5.0

# ATR period for volatility-adjusted gap sizing
# Production: 14 periods (standard technical analysis default)
MERID_FVG_ATR_PERIOD=14

# Minimum price change (cents) to trigger candle update
# Production: 0.5 cents prevents excessive updates from micro-movement
MERID_FVG_MIN_PRICE_CHANGE=0.5

# =============================================================================
# FVG SIGNAL CALIBRATION (Entry/Exit Timing)
# =============================================================================

# Base confidence multiplier for FVG signals (0.0 - 1.0)
# Production: 0.85 gives strong weight to FVG while allowing ensemble override
MERID_FVG_BASE_CONFIDENCE=0.85

# Proximity boost: Extra confidence when price is very close to FVG
# Production: 0.15 additional confidence at fill threshold proximity
MERID_FVG_PROXIMITY_BOOST=0.15

# Maximum FVG-derived edge percentage
# Production: 0.08 (8%) - caps FVG contribution to prevent over-leverage
MERID_FVG_MAX_EDGE_PCT=0.08

# Minimum confluence score to act on multi-timeframe FVG alignment
# Production: 0.30 (30%) ensures meaningful cross-timeframe agreement
MERID_FVG_MIN_CONFLUENCE_SCORE=0.30

# =============================================================================
# FVG POSITION SIZING IMPACT
# =============================================================================

# FVG signal multiplier for position sizing (1.0 = no impact)
# Production: 1.25 increases size 25% when strong FVG signal present
MERID_FVG_SIZE_MULTIPLIER=1.25

# FVG max position boost (caps the size increase from FVG)
# Production: 1.5 (max 50% size increase from FVG confluence)
MERID_FVG_MAX_POSITION_BOOST=1.5

# Reduce position when price is inside filled FVG zone (chop/range behavior)
# Production: 0.75 (25% reduction inside filled zones)
MERID_FVG_FILLED_ZONE_SIZE_FACTOR=0.75

# =============================================================================
# FVG ENTRY/EXIT TIMING
# =============================================================================

# Enable FVG-based entry timing optimization
MERID_FVG_ENTRY_TIMING_ENABLED=true

# Entry timing: Wait for price to be within X cents of FVG before entry
# Production: 3.0 cents - enter near FVG edges for optimal R/R
MERID_FVG_ENTRY_PROXIMITY_CENTS=3.0

# Enable FVG-based exit timing (take profit at opposing FVG)
MERID_FVG_EXIT_TIMING_ENABLED=true

# Exit timing: Take profit when opposing FVG is within X cents
# Production: 2.0 cents - tighter than entry for quick profits
MERID_FVG_EXIT_PROXIMITY_CENTS=2.0

# Hold position through FVG fill if confluence score > threshold
# Production: 0.60 (60%) - strong confluence overrides single FVG fill
MERID_FVG_HOLD_ON_CONFLUENCE_THRESHOLD=0.60

# =============================================================================
# FVG FORECASTER ENSEMBLE WEIGHTS
# =============================================================================

# FVG forecaster weight in ensemble (relative to other forecasters)
# Production: 0.25 (25% weight - balanced with sentiment, technical, etc.)
MERID_FVG_ENSEMBLE_WEIGHT=0.25

# FVG confluence bonus: Extra ensemble weight when multi-timeframe alignment
# Production: +0.15 (15% bonus) for strong confluence
MERID_FVG_CONFLUENCE_BONUS_WEIGHT=0.15

# =============================================================================
# FVG RISK MANAGEMENT
# =============================================================================

# Max FVG-based trades per hour per market (rate limiting)
# Production: 4 trades/hour prevents over-trading on FVG alone
MERID_FVG_MAX_TRADES_PER_HOUR=4

# Min seconds between FVG-based entries on same market (debounce)
# Production: 900 seconds (15 minutes) - aligns with 15m candle close
MERID_FVG_ENTRY_DEBOUNCE_SECONDS=900

# Cancel FVG entry if opposing FVG forms within X cents
# Production: 5.0 cents - conflicting signal threshold
MERID_FVG_OPPOSING_FVG_CANCEL_CENTS=5.0

# =============================================================================
# FVG MONITORING & ALERTS
# =============================================================================

# Enable FVG metrics collection
MERID_FVG_METRICS_ENABLED=true

# Log FVG signal generation details (verbose)
MERID_FVG_LOG_SIGNALS=true

# Alert when large FVG forms (> X cents)
# Production: 10.0 cents triggers large gap alert
MERID_FVG_LARGE_GAP_ALERT_CENTS=10.0

# Alert when FVG fill rate exceeds threshold (unusual market behavior)
# Production: 0.80 (80% of FVGs filling within 1 hour)
MERID_FVG_HIGH_FILL_RATE_ALERT=0.80

# =============================================================================
# FVG ASSET-SPECIFIC CALIBRATION (Override defaults per asset)
# =============================================================================

# BTC: Lower threshold for larger price movements
MERID_FVG_BTC_MIN_GAP_CENTS=3.0
MERID_FVG_BTC_FILL_THRESHOLD=7.0

# ETH: Standard thresholds
MERID_FVG_ETH_MIN_GAP_CENTS=2.5
MERID_FVG_ETH_FILL_THRESHOLD=6.0

# SOL: Slightly tighter for more responsive signals
MERID_FVG_SOL_MIN_GAP_CENTS=2.0
MERID_FVG_SOL_FILL_THRESHOLD=5.0

# XRP: Tighter thresholds for lower-priced asset
MERID_FVG_XRP_MIN_GAP_CENTS=1.5
MERID_FVG_XRP_FILL_THRESHOLD=4.0

# DOGE: Tightest thresholds (most volatile)
MERID_FVG_DOGE_MIN_GAP_CENTS=1.5
MERID_FVG_DOGE_FILL_THRESHOLD=4.0

# =============================================================================
# FVG PAPER/SHADOW MODE OVERRIDES (For testing)
# =============================================================================
# Uncomment to enable aggressive FVG testing in paper mode:
# MERID_FVG_MIN_GAP_CENTS=1.0
# MERID_FVG_ENTRY_PROXIMITY_CENTS=1.5
# MERID_FVG_MAX_TRADES_PER_HOUR=10
# MERID_FVG_ENTRY_DEBOUNCE_SECONDS=300

# =============================================================================
# END OF FVG PRODUCTION CONFIGURATION
# =============================================================================
