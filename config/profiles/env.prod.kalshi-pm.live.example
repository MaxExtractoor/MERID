# Canonical production + live PM (AgentGrid, Kalshi PM only).
# Copy values into your real .env or secret manager — do not commit secrets.
#
# MERID_PM_PROFILE=production
# MERID_PM_TRADING_MODE=live
# MERID_PM_LIVE_ENABLED=true
# MERID_ALLOW_LIVE_TRADES=true
# MERID_KALSHI_WS_CLIENT=ws
# MERID_ENABLE_KALSHI_CT=false
# MERID_VALIDATION_MODE=0
#
# KALSHI_ENV=live
# KALSHI_CONFIRM_LIVE=1
#
# Use live Kalshi API credentials (see ENV_SETUP.md / Kalshi docs).
#
# Kill switch: if data/risk_kill_switch.json has active=true, production
# AgentGrid preflight refuses to start until cleared or file removed (process restart).
#
# Strict group ID validation - ensures FilterPipeline and order_router agree on group_id.
# Mismatches cause AssertionError in production (fail-closed). Disable only for emergency.
KALSHI_STRICT_GROUP_ID=true
#
# One-call readiness (after boot, with operator session):
#   GET /api/v1/operator/pm-live-readiness
# Expect: ready_for_live_pm_trading=true and all checks.* true.
# After fixes validation: ensure no [TAINTED_PATH] logs appear in first 5 minutes.
