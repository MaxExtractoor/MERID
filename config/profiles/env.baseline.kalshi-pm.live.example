# BASELINE LIVE PROFILE - Fire-and-Forget Configuration (2026-05-11)
# ========================================================================
# This profile represents the stable, long-term baseline for 15m crypto
# prediction market trading after structural fixes and relaxation.
#
# Version: baseline-v1
# Date: 2026-05-11
# Purpose: Fire-and-forget operation with realistic edge gates, real sentiment,
#          relaxed timing, and robust error recovery.
#
# USAGE:
#   Copy this file to .env and set your Kalshi API credentials.
#   Set MERID_PM_PROFILE=baseline to activate this profile.
#
# RISK CONTROLS:
#   - Bankroll allocation: 1-3% per cycle (MAX_CYCLE_RISK_PCT = 0.05)
#   - Drawdown envelope: 15% max
#   - Edge gate: 2% minimum for 15m crypto (realistic thin edges)
#   - No paper edge boost (disabled for genuine model edge)
#
# TIMING RELAXATION:
#   - Event-loop lag warning: 30s threshold (was 10s)
#   - Lag warning interval: 60s (was 30s)
#   - Circuit breaker recovery: 90-180s (was 60-120s)
#   - Agent drain timeout: 60s (was 30s)
#   - Agent stop timeout: 10s (was 5s)
#
# DATA SOURCES:
#   - Sentiment: Twitter API with Reddit fallback (real data, no fake neutral)
#   - Market discovery: Timezone-aware end_date parsing (fixed window filter)
#   - Fill accounting: Derive count from proceeds when missing
# ========================================================================

# Baseline live configuration (production-like but with safety rails)
MERID_PM_PROFILE=baseline
MERID_PM_TRADING_MODE=live
MERID_PM_LIVE_ENABLED=true
MERID_KALSHI_WS_CLIENT=ws
MERID_ENABLE_KALSHI_CT=false
MERID_VALIDATION_MODE=0

# Kalshi environment
KALSHI_ENV=live
KALSHI_CONFIRM_LIVE=1

# ========================================================================
# EV-BASED EDGE GATES - Economic edge thresholds for 15m crypto markets
# ========================================================================
# EV-based gating replaces prob_edge = |p - 0.5| with economic edge (net of fees)
# All thresholds are asset-agnostic and scaled by actual Kalshi fees
#
# Baseline EV multiple over fees for all trades
# ev_net must exceed k_base * fee_per_contract to pass safety margin gate
MERID_EV_K_BASE=1.5

# Stricter EV multiple when model_prob is in extreme tails (<0.10 or >0.90)
# Compensates for higher calibration risk in probability extremes
MERID_EV_K_EXTREME=2.5

# EV multiple required in terminal expiry phase (last hour)
# Stricter requirement near expiry to account for time decay and liquidity
MERID_EV_K_TERMINAL=2.0

# ========================================================================
# LEGACY PROBABILITY EDGE GATES - DEPRECATED, kept for backward compatibility
# ========================================================================
# These are NO LONGER USED for 15m crypto trading after EV gate refactor
# Kept only for non-15m timeframes or legacy agent compatibility
#
# Minimum probability edge for terminal phase (near expiry)
MERID_PM_MIN_EDGE_TERMINAL=0.02

# Minimum probability edge for early phase
# CONFIG-FIX: Updated from 0.08 to 0.02 to match kalshi_crypto_15m.yaml profile (2026-05-16)
# Previous 8% threshold caused systemic no-trade behavior (terminal_edge_too_low)
MERID_PM_MIN_EDGE_EARLY=0.02

# Minimum probability edge for mid phase
MERID_PM_MIN_EDGE_MID=0.07

# Minimum probability edge for late phase
MERID_PM_MIN_EDGE_LATE=0.06

# Minimum confidence threshold
# Lowered from 0.58 to 0.51 to allow more signals through
MERID_PM_MIN_CONFIDENCE=0.51

# ========================================================================
# PAPER EDGE BOOST - DISABLED for genuine model edge
# ========================================================================
# Keep this disabled in baseline profile to ensure live stats reflect
# genuine model edge, not boosted artificial edge.
# Reserve for separate "plumbing test" mode only.
# MERID_PAPER_EDGE_BOOST=0.0

# ========================================================================
# TIMING RELAXATION - System breathing room
# ========================================================================
# Event-loop lag warning threshold (ms)
# Increased from 10000ms to 30000ms to reduce false alarms
MERID_WS_LAG_WARN_THRESHOLD_MS=30000

# Lag warning interval (seconds)
# Increased from 30s to 60s to reduce log noise
# (This is hardcoded in ws.py, not an env var)

# ========================================================================
# RISK CONTROLS - Bankroll and drawdown limits
# ========================================================================
# Maximum cycle risk as fraction of bankroll
# Set in core.settings.MAX_CYCLE_RISK_PCT = 0.05 (5%)
# Effective risk is typically 1-3% per cycle via position sizing

# Maximum drawdown before position sizing reduces
# Set in risk management system to 15% envelope

# ========================================================================
# SENTIMENT SOURCES - Real data only
# ========================================================================
# Twitter API key (required for primary sentiment source)
# TWITTER_API_KEY=your_key_here
# TWITTER_API_SECRET=your_secret_here
# TWITTER_BEARER_TOKEN=your_token_here

# Reddit fallback (automatic when Twitter fails)
# No configuration needed - uses public JSON feeds

# ========================================================================
# VALIDATION AND SAFETY
# ========================================================================
# Strict group ID validation
KALSHI_STRICT_GROUP_ID=true

# Strict fill ID validation (live trades only)
MERID_STRICT_FILL_ID=1

# Paper session halt/downsize override (fire-and-forget mode)
# Set to true to bypass paper session risk governance (halt/downsize state)
# This allows trading even if an agent was previously halted due to poor performance
# Use with caution: disables automatic risk protection
DISABLE_PAPER_SESSION_HALT=true

# Kill switch file path (data/risk_kill_switch.json)
# If active=true, AgentGrid preflight refuses to start

# ========================================================================
# AUDIT PIPELINE - Production Safety Controls
# ========================================================================
# Tighter entry windows for 15m crypto markets
# Reduces late-entry traps by restricting entries to last 10 minutes before expiry
# with a hard cutoff 2 minutes before expiry.
MERID_PM_ENTRY_WINDOW_15M_MINUTES=10
MERID_PM_ENTRY_WINDOW_15M_CUTOFF=2

# Strict settlement mode - require official Kalshi API results
# Prevents inference-based settlements that could have semantic drift
# If API doesn't have outcome, settlement fails rather than inferring
MERID_SETTLEMENT_REQUIRE_API_RESULT=true

# ========================================================================
# LOGGING LEVELS
# ========================================================================
# Window filter logging: INFO level (for diagnosis)
# Calibration logging: DEBUG level (model internals)
# Catalog logging: INFO level (stepwise market discovery)

# ========================================================================
# POST-RESTART CHECKLIST
# ========================================================================
# Within first hour:
#   [ ] Confirm each 15m agent logs markets_in_window > 0 consistently
#   [ ] Check trades pass prob_edge gate with 2-5% edges
#   [ ] Verify no [PM_WINDOW_FILTER] rejections for valid markets
#
# Within first 24 hours:
#   [ ] Inspect fills for derived count from proceeds
#   [ ] Spot-check Reddit fallback sentiment values (not near-zero)
#   [ ] Confirm no excessive event-loop lag warnings
#   [ ] Verify circuit breakers not opening frequently
#
# If all pass: system is ready for fire-and-forget operation
# ========================================================================
