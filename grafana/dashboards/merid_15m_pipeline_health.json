{
  "dashboard": {
    "id": null,
    "title": "MERID 15m Pipeline Health",
    "tags": ["merid", "kalshi", "15m", "crypto"],
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Pipeline Status Overview",
        "type": "stat",
        "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(merid_pipeline_cycles_total)",
            "legendFormat": "Total Cycles"
          },
          {
            "expr": "sum(merid_pipeline_decisions_total)",
            "legendFormat": "Total Decisions"
          },
          {
            "expr": "avg(merid_pipeline_success_rate)",
            "legendFormat": "Avg Success Rate"
          }
        ]
      },
      {
        "id": 2,
        "title": "Decision Rate by Asset (5m)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "rate(merid_pipeline_decisions_total[5m])",
            "legendFormat": "{{asset}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Decisions/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Pipeline Success Rate by Asset",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "merid_pipeline_success_rate",
            "legendFormat": "{{asset}} - {{pipeline_id}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "Success Rate"},
          {"format": "short"}
        ]
      },
      {
        "id": 4,
        "title": "Decision Confidence Distribution (95th Percentile)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, merid_pipeline_decisions_confidence)",
            "legendFormat": "{{asset}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "Confidence"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Edge Estimate Distribution (95th Percentile)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, merid_pipeline_decisions_edge_estimate)",
            "legendFormat": "{{asset}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Edge Estimate"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "Order Fill Rate (5m)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "rate(merid_orders_filled_total[5m]) / (rate(merid_orders_submitted_total[5m]) + 0.001) * 100",
            "legendFormat": "{{asset}} - {{price_band}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Fill Rate %"},
          {"format": "short"}
        ],
        "description": "Order fill rate by asset and price band (48-52c = near_money)"
      },
      {
        "id": 7,
        "title": "Average Time on Book (5m)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "rate(merid_order_time_on_book_seconds_sum[5m]) / rate(merid_order_time_on_book_seconds_count[5m])",
            "legendFormat": "{{asset}} - {{price_band}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Seconds on Book"},
          {"format": "short"}
        ],
        "description": "Average time orders spend on the book before fill/cancel/expire"
      },
      {
        "id": 8,
        "title": "Order Volume by State (5m)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 28},
        "targets": [
          {
            "expr": "rate(merid_orders_submitted_total[5m])",
            "legendFormat": "Submitted - {{asset}}",
            "refId": "A"
          },
          {
            "expr": "rate(merid_orders_filled_total[5m])",
            "legendFormat": "Filled - {{asset}}",
            "refId": "B"
          },
          {
            "expr": "rate(merid_orders_cancelled_total[5m])",
            "legendFormat": "Cancelled - {{asset}}",
            "refId": "C"
          },
          {
            "expr": "rate(merid_orders_expired_total[5m])",
            "legendFormat": "Expired - {{asset}}",
            "refId": "D"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Orders/sec"},
          {"format": "short"}
        ],
        "description": "Order volume by terminal state"
      },
      {
        "id": 9,
        "title": "Feature Namespace Sparsity",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 36},
        "targets": [
          {
            "expr": "merid_feature_namespace_sparsity",
            "legendFormat": "{{asset}} - {{namespace}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "Sparsity"},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "Pipeline Latency Breakdown (95th Percentile)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 28},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, merid_pipeline_feature_build_duration_seconds)",
            "legendFormat": "Feature Build - {{asset}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, merid_pipeline_decision_duration_seconds)",
            "legendFormat": "Decision - {{asset}}",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.95, merid_pipeline_risk_check_duration_seconds)",
            "legendFormat": "Risk Check - {{asset}}",
            "refId": "C"
          },
          {
            "expr": "histogram_quantile(0.95, merid_pipeline_execution_duration_seconds)",
            "legendFormat": "Execution - {{asset}}",
            "refId": "D"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration (seconds)"},
          {"format": "short"}
        ]
      },
      {
        "id": 8,
        "title": "Risk Check Veto Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 36},
        "targets": [
          {
            "expr": "merid_risk_check_veto_rate",
            "legendFormat": "{{asset}} - {{check_name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "Veto Rate"},
          {"format": "short"}
        ]
      },
      {
        "id": 9,
        "title": "Risk Check Failure Count",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 36},
        "targets": [
          {
            "expr": "rate(merid_risk_check_failed[5m])",
            "legendFormat": "{{asset}} - {{check_name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Failures/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 10,
        "title": "Execution Success Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 44},
        "targets": [
          {
            "expr": "merid_execution_success_rate",
            "legendFormat": "{{asset}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "Success Rate"},
          {"format": "short"}
        ]
      },
      {
        "id": 11,
        "title": "Cumulative PnL",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 44},
        "targets": [
          {
            "expr": "merid_execution_pnl",
            "legendFormat": "{{asset}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "currencyUSD", "label": "PnL ($)"},
          {"format": "short"}
        ]
      },
      {
        "id": 12,
        "title": "Feature Agent Health Status",
        "type": "table",
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 52},
        "targets": [
          {
            "expr": "merid_feature_agent_healthy",
            "legendFormat": "{{agent_name}}",
            "refId": "A",
            "format": "table"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true, "__name__": true},
              "indexByName": {},
              "renameByName": {
                "asset": "Asset",
                "agent_name": "Agent",
                "Value": "Healthy"
              }
            }
          }
        ]
      },
      {
        "id": 13,
        "title": "Feature Agent Invocation Duration (95th Percentile)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 62},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, merid_feature_agent_invocation_duration_seconds)",
            "legendFormat": "{{agent_name}} ({{namespace}})",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration (seconds)"},
          {"format": "short"}
        ]
      },
      {
        "id": 14,
        "title": "Pipeline Healthy Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 24, "x": 0, "y": 70},
        "targets": [
          {
            "expr": "min(merid_pipeline_healthy)",
            "legendFormat": "All Pipelines Healthy",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {"text": "UNHEALTHY"},
                  "1": {"text": "HEALTHY"}
                }
              }
            ]
          }
        }
      },
      {
        "id": 15,
        "title": "Market Data Staleness (P2 Task 7)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 74},
        "targets": [
          {
            "expr": "merid_market_data_staleness_seconds",
            "legendFormat": "{{asset}} - {{ticker}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Staleness (seconds)"},
          {"format": "short"}
        ],
        "description": "Seconds since last market data update per ticker. Alert if >90s."
      },
      {
        "id": 16,
        "title": "Market Health Status (P2 Task 7)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 74},
        "targets": [
          {
            "expr": "merid_market_health_status",
            "legendFormat": "{{asset}} - {{ticker}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Health (0=unhealthy, 4=healthy)"},
          {"format": "short"}
        ],
        "description": "Health status: 0=unhealthy, 1=degraded, 2=stale, 3=suspended, 4=healthy"
      },
      {
        "id": 17,
        "title": "WS Events Dropped by Type (P2 Task 7)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 82},
        "targets": [
          {
            "expr": "rate(merid_ws_events_dropped_total[5m])",
            "legendFormat": "{{event_type}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Drops/sec"},
          {"format": "short"}
        ],
        "description": "WS bridge backpressure: events dropped per type due to queue overflow"
      },
      {
        "id": 18,
        "title": "WS Fills Dropped (P2 Task 7)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 12, "x": 12, "y": 82},
        "targets": [
          {
            "expr": "rate(merid_ws_fills_dropped_total[5m])",
            "legendFormat": "Fills Dropped/sec",
            "refId": "A"
          },
          {
            "expr": "increase(merid_ws_fills_dropped_total[5m])",
            "legendFormat": "Total Fills Dropped (5m)",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 0.1},
                {"color": "red", "value": 1}
              ]
            }
          }
        },
        "description": "Critical: fills dropped due to WS bridge backpressure"
      }
    ]
  }
}
