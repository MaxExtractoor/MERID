# TypeScript Swarm Agents (Node.js)
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY packages/swarm-kernel/package*.json ./packages/swarm-kernel/
COPY packages/agents/package*.json ./packages/agents/
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source
COPY packages/swarm-kernel/ ./packages/swarm-kernel/
COPY packages/agents/ ./packages/agents/
COPY tsconfig.json ./

# Build TypeScript
RUN npm run build

# Production image
FROM node:20-alpine

WORKDIR /app

# Copy built artifacts
COPY --from=builder /app/packages/swarm-kernel/dist ./packages/swarm-kernel/dist
COPY --from=builder /app/packages/agents/dist ./packages/agents/dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./

# Create entrypoint
COPY infra/swarm_agents_entrypoint.js .

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD node -e "process.exit(0)"

# Run agents
CMD ["node", "swarm_agents_entrypoint.js"]
