# Python Kalshi WebSocket Bridge
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install additional dependencies for Kalshi bridge
RUN pip install --no-cache-dir \
    websockets==12.0 \
    cryptography==41.0.7 \
    nats-py==2.6.0 \
    pydantic==2.5.0

# Copy application code
COPY merid_core/ ./merid_core/
COPY merid_agents/ ./merid_agents/
COPY merid/ ./merid/
COPY core/ ./core/

# Create bridge entrypoint
COPY infra/kalshi_bridge_entrypoint.py .

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python -c "import sys; sys.exit(0)"

# Run bridge
CMD ["python", "kalshi_bridge_entrypoint.py"]
