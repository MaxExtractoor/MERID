{
  "name": "bars-pg-sink",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "2",
    "topics.regex": "bars\\.1m\\..*",
    "connection.url": "jdbc:postgresql://trading-db:5432/merid",
    "connection.user": "${file:/opt/kafka-connect/secrets/pg-credentials.properties:username}",
    "connection.password": "${file:/opt/kafka-connect/secrets/pg-credentials.properties:password}",
    "auto.create": "true",
    "auto.evolve": "true",
    "insert.mode": "upsert",
    "pk.mode": "record_value",
    "pk.fields": "symbol,window_end",
    "delete.enabled": "false",
    "table.name.format": "bars_1m_${topic}",
    "batch.size": "500",
    "max.retries": "10",
    "retry.backoff.ms": "3000",
    "transforms": "extractTopic",
    "transforms.extractTopic.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.extractTopic.regex": "bars\\.1m\\.(.*)",
    "transforms.extractTopic.replacement": "$1"
  }
}
