# MERID Production Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================================================
# CORE SYSTEM
# ============================================================================
MERID_ENV=production
MERID_LOG_LEVEL=INFO

# ============================================================================
# OLLAMA CONFIGURATION
# ============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATE_ENDPOINT=/api/generate

# ============================================================================
# NEO4J GRAPH DATABASE
# ============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ============================================================================
# TWITTER (X) API CREDENTIALS
# ============================================================================
# Get credentials from: https://developer.twitter.com/
X_BEARER_TOKEN=your_twitter_bearer_token_here
X_API_KEY=your_twitter_api_key_here
X_API_SECRET=your_twitter_api_secret_here
X_ACCESS_TOKEN=your_twitter_access_token_here
X_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# ============================================================================
# TELEGRAM BOT
# ============================================================================
# Get bot token from: https://t.me/BotFather
MERID_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
MERID_TELEGRAM_CHAT_ID=@merid_alerts

# ============================================================================
# NEWS FEEDS
# ============================================================================
# CryptoCompare API (optional, has free tier)
# Get from: https://www.cryptocompare.com/cryptopian/api-keys
CRYPTOCOMPARE_API_KEY=your_cryptocompare_api_key_here

# ============================================================================
# BLOCKCHAIN & ORACLES
# ============================================================================
# Polygon RPC (for UMA Oracle)
# Get from: https://www.alchemy.com/ or https://infura.io/
MERID_POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/your_key_here

# Oracle private key (for UMA assertions)
# IMPORTANT: Use a dedicated wallet with minimal funds
MERID_ORACLE_PRIVATE_KEY=your_private_key_here

# Chainlink integration
MERID_CHAINLINK_ENABLED=true

# UMA Oracle
MERID_ENABLE_UMA_ORACLE=true

# ============================================================================
# POLYMARKET INTEGRATION
# ============================================================================
MERID_POLYMARKET_MOCK=false
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_PRIVATE_KEY=your_polymarket_private_key_here

# ============================================================================
# PERP DEX ADAPTERS
# ============================================================================
# Hyperliquid
HYPERLIQUID_API_KEY=your_hyperliquid_api_key_here
HYPERLIQUID_PRIVATE_KEY=your_hyperliquid_private_key_here

# dYdX
DYDX_API_KEY=your_dydx_api_key_here
DYDX_PRIVATE_KEY=your_dydx_private_key_here

# GMX
GMX_RPC_URL=https://arb1.arbitrum.io/rpc

# ============================================================================
# CEX ADAPTERS
# ============================================================================
# Binance
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Bybit
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# Coinbase
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_API_SECRET=your_coinbase_api_secret_here

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
MERID_DASHBOARD_API_KEY=your_secure_dashboard_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_here

# ============================================================================
# CORS & ALLOWED ORIGINS
# ============================================================================
MERID_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com

# ============================================================================
# FEATURE FLAGS
# ============================================================================
MERID_ENABLE_GAMIFICATION=true
MERID_GAMIFICATION_BASE_XP=50

# Consensus & Validation
MERID_CONSENSUS_THRESHOLD=0.66
MERID_CONFIDENCE_FLOOR=0.40

# Mining
MERID_MINING_DIFFICULTY=4
MERID_MIN_CONFIDENCE_THRESHOLD=0.70

# ============================================================================
# MONITORING & ANALYTICS
# ============================================================================
# Whale tracking
WHALE_TRACKING_ENABLED=true
WHALE_THRESHOLD_USD=1000000

# Liquidation monitoring
LIQUIDATION_MONITORING_ENABLED=true

# On-chain analytics
ONCHAIN_ANALYTICS_ENABLED=true

# ============================================================================
# MARL & SWARM INTELLIGENCE
# ============================================================================
# Multi-Agent Reinforcement Learning
MARL_ALGORITHM=COMA
MARL_LEARNING_RATE=0.0003
MARL_BATCH_SIZE=32
MARL_DEVICE=cpu

# Particle Swarm Optimization
PSO_PARTICLES=20
PSO_ITERATIONS=100

# Agent Evolution
MAX_AGENT_POPULATION=12
AGENT_SPAWN_THRESHOLD=0.60
AGENT_STALE_SCORE=0.35

# ============================================================================
# AIRFLOW ORCHESTRATION (Optional)
# ============================================================================
AIRFLOW_HOME=/path/to/airflow
AIRFLOW_DAGS_FOLDER=/path/to/merid/dags

# ============================================================================
# RAY RLLIB (Optional - for distributed MARL)
# ============================================================================
RAY_NUM_CPUS=4
RAY_NUM_GPUS=0
RAY_OBJECT_STORE_MEMORY=2000000000

# ============================================================================
# CONTACT & BRANDING
# ============================================================================
MERID_TWITTER=@MERIDonX
MERID_TELEGRAM=https://t.me/MaxExtractoor
MERID_CONTACT_EMAIL=merid_engine@outlook.com

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit .env file to version control
# 2. Use strong, unique passwords and API keys
# 3. Rotate credentials regularly
# 4. Use dedicated wallets with minimal funds for blockchain operations
# 5. Enable 2FA on all exchange accounts
# 6. Monitor API usage and rate limits
# 7. Keep dependencies updated for security patches
