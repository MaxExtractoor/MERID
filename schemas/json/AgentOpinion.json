{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merid.io/schemas/AgentOpinion.json",
  "title": "AgentOpinion",
  "description": "Agent opinion for consensus voting",
  "type": "object",
  "required": ["agent_id", "symbol", "stance", "score", "confidence", "rationale"],
  "properties": {
    "opinion_id": {
      "type": "string",
      "description": "Unique opinion identifier"
    },
    "agent_id": {
      "type": "string",
      "description": "ID of the agent submitting the opinion"
    },
    "role": {
      "type": "string",
      "description": "Role of the agent"
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "description": "Trading symbol"
    },
    "venue": {
      "type": "string",
      "description": "Trading venue"
    },
    "stance": {
      "type": "string",
      "enum": ["strong_bull", "bull", "neutral", "bear", "strong_bear"],
      "description": "Agent's stance on the asset"
    },
    "score": {
      "type": "number",
      "minimum": -1.0,
      "maximum": 1.0,
      "description": "Numeric score from -1 (strong bear) to 1 (strong bull)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence level in the opinion"
    },
    "rationale": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000,
      "description": "Reasoning behind the opinion"
    },
    "horizon": {
      "type": "string",
      "enum": ["short", "medium", "long"],
      "description": "Time horizon for the opinion"
    },
    "data_sources": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Data sources used for analysis"
    },
    "supporting_data": {
      "type": "object",
      "description": "Additional supporting data"
    }
  },
  "additionalProperties": false
}
