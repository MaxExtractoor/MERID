{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merid.io/schemas/v1.0/ConsensusBlock.json",
  "title": "ConsensusBlock",
  "description": "Canonical schema for MERID consensus blocks - immutable records of collective decisions",
  "version": "1.0.0",
  "type": "object",
  "required": ["block_id", "block_number", "timestamp", "proposal", "votes", "result", "previous_hash", "block_hash"],
  "properties": {
    "block_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this consensus block"
    },
    "block_number": {
      "type": "integer",
      "minimum": 0,
      "description": "Sequential block number in the consensus chain"
    },
    "timestamp": {
      "type": "number",
      "description": "Unix timestamp when block was finalized"
    },
    "proposal": {
      "type": "object",
      "required": ["proposal_id", "intent_id", "proposer", "created_at"],
      "properties": {
        "proposal_id": {
          "type": "string",
          "format": "uuid"
        },
        "intent_id": {
          "type": "string",
          "format": "uuid",
          "description": "Reference to the IntentEnvelope being voted on"
        },
        "proposer": {
          "type": "string",
          "description": "Agent ID that created the proposal"
        },
        "created_at": {
          "type": "number"
        },
        "description": {
          "type": "string"
        },
        "urgency": {
          "type": "string",
          "enum": ["low", "normal", "high", "critical"],
          "default": "normal"
        }
      }
    },
    "votes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["voter_id", "vote", "weight", "timestamp", "signature"],
        "properties": {
          "voter_id": {
            "type": "string",
            "description": "Agent ID of the voter"
          },
          "vote": {
            "type": "string",
            "enum": ["approve", "reject", "abstain"]
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Trust-weighted vote power"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Voter's confidence in their decision"
          },
          "reasoning": {
            "type": "string",
            "description": "Optional explanation for the vote"
          },
          "timestamp": {
            "type": "number"
          },
          "signature": {
            "type": "string"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["outcome", "approval_rate", "quorum_met", "finalized_at"],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["approved", "rejected", "expired", "cancelled"]
        },
        "approval_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Weighted approval percentage"
        },
        "quorum_met": {
          "type": "boolean"
        },
        "total_weight": {
          "type": "number",
          "minimum": 0
        },
        "approve_weight": {
          "type": "number",
          "minimum": 0
        },
        "reject_weight": {
          "type": "number",
          "minimum": 0
        },
        "abstain_weight": {
          "type": "number",
          "minimum": 0
        },
        "finalized_at": {
          "type": "number"
        }
      }
    },
    "execution_ref": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Reference to ExecutionResult if approved and executed"
    },
    "previous_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash of the previous block"
    },
    "block_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash of this block"
    },
    "merkle_root": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Merkle root of all votes"
    }
  },
  "additionalProperties": false
}
