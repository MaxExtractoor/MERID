# MERID Configuration
# Copy this file to .env and customize for your environment

# Environment: development, staging, production
MERID_ENV=development

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
DEBUG=true
CORS_ORIGINS=*

# Database Configuration (optional - for future use)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=merid
DB_USER=merid
DB_PASSWORD=
DB_POOL_SIZE=10

# Exchange Configuration
EXCHANGE_NAME=coinbase
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_SANDBOX=true
EXCHANGE_RATE_LIMIT=1.0

# Trading Configuration
TRADING_MODE=paper
TRADING_INITIAL_CAPITAL=100000
TRADING_MAX_POSITION=10000
TRADING_MAX_EXPOSURE=50000
TRADING_STOP_LOSS_PCT=0.02
TRADING_TAKE_PROFIT_PCT=0.04
TRADING_SLIPPAGE_PCT=0.001
TRADING_COMMISSION_PCT=0.001

# Agent Configuration
AGENT_NUM_AGENTS=8
AGENT_CONSENSUS_THRESHOLD=0.65
AGENT_VOTE_TIMEOUT=30
AGENT_DEFAULT_MODEL=merid-strategist:latest
OLLAMA_HOST=http://localhost:11434

# Alert Configuration
ALERT_CHECK_INTERVAL=5
ALERT_MAX_PER_SYMBOL=10
ALERT_RETENTION_HOURS=24

# Feature Flags
ENABLE_LIVE_TRADING=false
ENABLE_PREDICTION_MARKETS=true
ENABLE_NEWS_MONITORING=true
ENABLE_BACKTESTING=true
