# .env.example - MERID Master Environment File Template
# Location: C:\Dev\MERID\.env.example
# Copy this to .env and fill in your actual values
# NEVER commit .env to git! Add to .gitignore

# =============================================================================
# CORE LOCAL SYSTEM
# =============================================================================
MERID_ENV=development
MERID_LOG_LEVEL=INFO
MERID_DEV_ALLOW_WS=true

# Minimum swarm consensus confidence (0-1) for sentiment-sized orders; 0 disables
MERID_SWARM_CONFIDENCE_MIN=0
# Hashtag volume above this multiple of rolling average is treated as suspect/spam
MERID_HASHTAG_ABUSE_VOLUME_MULT=4.0
# Max fraction of crypto category notional (split across 5 assets) for sentiment-tagged orders
MERID_SENTIMENT_PER_ASSET_CAP_FRACTION=0.25

# =============================================================================
# LIVE-ONLY MODE SETTINGS
# =============================================================================
MERID_USE_MOCK_ARB_DATA=false
MERID_USE_DEMO_TRADES=false
MERID_USE_SAMPLE_DATA=false
MERID_USE_MOCK_STREAMS=false

MERID_ENABLE_LIVE_PRICE_FEEDS=true
MERID_ENABLE_REAL_PREDICTION_MARKETS=true
MERID_ENABLE_REAL_SOLANA_WS=true
MERID_ENABLE_REAL_NEWS=true

# =============================================================================
# EMAIL NOTIFICATIONS
# =============================================================================
MY_EMAIL=your_email@gmail.com
APP_PASSWORD=your_app_password
RECEIVER_EMAIL=your_receiver@outlook.com

# =============================================================================
# TELEGRAM ALERTS
# =============================================================================
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# =============================================================================
# SUPABASE
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
PUBLISHABLE_KEY=your_publishable_key

# =============================================================================
# POSTGRESQL DATABASE (replaces SQLite for fills ledger and position tracking)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=merid
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=merid

# =============================================================================
# MARKET DATA APIs
# =============================================================================
MESSARI_API_KEY=your_messari_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
POLYGON_API_KEY=your_polygon_api_key
NEWS_API_KEY=your_news_api_key
SERPER_API_KEY=your_serper_api_key
FRED_API_KEY=your_fred_api_key
FINNHUB_API_KEY=your_finnhub_api_key
THE_GRAPH_API_KEY=your_graph_api_key

# =============================================================================
# BLOCKCHAIN & SOLANA
# =============================================================================
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_key

# =============================================================================
# AI & MACHINE LEARNING
# =============================================================================
HUGGINGFACE_API_KEY=your_huggingface_key
CLAUDE_SONNET_4=your_claude_api_key
DEEPSEEK_API_KEY=your_deepseek_key
OLLAMA_API_KEY=your_ollama_key
OPENAI_API_KEY=your_openai_key
OPEN_ROUTER_API_KEY=your_openrouter_key

# =============================================================================
# DATABASE & INFRASTRUCTURE
# =============================================================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=your_app
RAILWAY_API_TOKEN=your_railway_token
REDIS_URL=redis://username:password@host:port

# =============================================================================
# COMMUNICATION & NOTIFICATIONS
# =============================================================================
TWILIO_SID=your_twilio_sid
TWILIO_TOKEN=your_twilio_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_sid
TWILIO_PHONE=+15551234567

# =============================================================================
# X (TWITTER) API
# =============================================================================
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_BEARER_TOKEN=your_x_bearer_token
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret

# =============================================================================
# PAPER TRADING (ALPACA)
# =============================================================================
PAPER_BROKER=alpaca
PAPER_API_KEY=your_alpaca_paper_key
PAPER_API_SECRET=your_alpaca_paper_secret
PAPER_API_BASE=https://paper-api.alpaca.markets
PAPER_DATA_SOURCE=alpaca

# Alpaca credentials (MERID_ prefix preferred, legacy also supported)
MERID_ALPACA_API_KEY=your_alpaca_paper_key
MERID_ALPACA_API_SECRET=your_alpaca_paper_secret
ALPACA_API_KEY=your_alpaca_paper_key
ALPACA_API_SECRET=your_alpaca_paper_secret

# =============================================================================
# CEX ADAPTERS
# =============================================================================
# Binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Coinbase Advanced Trade (MERID_ prefix preferred; COINBASE_CLIENT_* = CDP portal names)
MERID_COINBASE_API_KEY=your_coinbase_api_key
MERID_COINBASE_API_SECRET=your_coinbase_api_secret
COINBASE_CLIENT_API_KEY=your_coinbase_client_api_key
COINBASE_CLIENT_API_SECRET=your_coinbase_client_api_secret
COINBASE_API_KEY=your_coinbase_api_key
COINBASE_API_SECRET=your_coinbase_api_secret

# Kraken
KRAKEN_API_KEY=your_kraken_api_key
KRAKE_PRIVATE_KEY=your_kraken_private_key

# OKX
OKX_API_KEY=your_okx_api_key
OKX_SECRET_KEY=your_okx_secret_key
OKX_API_KEY_NAME=MERID
OKX_PERMISSIONS=Read

# Bybit (optional)
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret

# =============================================================================
# PREDICTION MARKETS — KALSHI
# IMPORTANT: sandbox and live credentials are SEPARATE key pairs.
# KalshiConfig will raise ValueError if KALSHI_ENV=live but only demo keys
# are present, and vice-versa.  Never mix sandbox and live key IDs.
# =============================================================================

# --- Sandbox / Demo (paper-trading) ---
KALSHI_DEMO_API_KEY_ID=your_kalshi_demo_api_key_id
KALSHI_DEMO_PRIVATE_KEY_PATH=kalshi_demo_private_key.pem
# KALSHI_DEMO_PRIVATE_KEY_PEM=  # Alternative: paste raw PEM string

# --- Live (real-money) ---
KALSHI_LIVE_API_KEY_ID=your_kalshi_live_api_key_id
KALSHI_LIVE_PRIVATE_KEY_PATH=kalshi_live_private_key.pem
# KALSHI_LIVE_PRIVATE_KEY_PEM=  # Alternative: paste raw PEM string

# Active environment — "demo" or "live"
# KalshiConfig reads the correct key pair based on this value.
# Production server: KALSHI_ENV=live with KALSHI_LIVE_* credentials filled in.
KALSHI_ENV=demo

# Legacy single-key vars (still supported; KALSHI_ENV takes precedence)
KALSHI_API_KEY_ID=your_kalshi_api_key_id
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key.pem
# KALSHI_PRIVATE_KEY_PEM=  # Alternative: paste raw PEM string
KALSHI_USE_DEMO=true

# Optional explicit API base (unset = SDK default). Live host requires KALSHI_CONFIRM_LIVE=1.
# KALSHI_API_URL=https://demo-api.kalshi.co/trade-api/v2
# KALSHI_CONFIRM_LIVE=1
# Cash / sizing for continuous trader (positive decimal; readiness warns if unset)
# KALSHI_TRADER_BANKROLL=10000.00

# Profile slices (merge into .env): .env.kalshi-demo / .env.kalshi-sim (demo), .env.kalshi-live-prod (live)
# Persisted kill switch path (runtime state file — keep "active": false in git): 
# MERID_RISK_KS_FILE=data/risk_kill_switch.json

# --- Trading Mode Safety ---
# MERID_TRADE_MODE: mock | paper | live (default: paper)
MERID_TRADE_MODE=paper
# MERID_ALLOW_LIVE_TRADES: required for VenueGate LIVE — without this, PM mode is forced to paper
MERID_ALLOW_LIVE_TRADES=false
# Prediction market mode (PM / Kalshi). Production server example:
#   MERID_PM_TRADING_MODE=live
#   MERID_PM_LIVE_ENABLED=true
#   MERID_ALLOW_LIVE_TRADES=true
#   KALSHI_ENV=live
MERID_PM_TRADING_MODE=paper
MERID_PM_LIVE_ENABLED=false
# production | development — production fail-fast AgentGrid + blocks CT + requires WS client ws
# MERID_PM_PROFILE=production
# Continuous trader (legacy crypto loop) — off by default; AgentGrid is the PM stack
MERID_ENABLE_KALSHI_CT=false
# Kalshi WS implementation — use ws for live (websocket_service is dev-only)
MERID_KALSHI_WS_CLIENT=ws

# =============================================================================
# ANALYTICS & INTELLIGENCE
# =============================================================================
NANSEN_API_KEY=your_nansen_api_key
MERID_COINGLASS_API_KEY=your_coinglass_api_key
MERID_NANSEN_API_KEY=your_nansen_api_key
MERID_ARKHAM_API_KEY=your_arkham_api_key
MERID_GLASSNODE_API_KEY=your_glassnode_api_key
MERID_SANTIMENT_API_KEY=your_santiment_api_key

# =============================================================================
# IBKR PAPER
# =============================================================================
IBKR_PAPER_TRADING_USERNAME=your_ibkr_username
IBKR_PAPER_TRADING_ACCOUNT_NUMBER=your_ibkr_account

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
MERID_DASHBOARD_API_KEY=your_dashboard_api_key
JWT_SECRET_KEY=your_jwt_secret_key
SESSION_SECRET=your_session_secret

# =============================================================================
# CORS
# =============================================================================
MERID_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# =============================================================================
# FEATURE FLAGS (SIM / RESEARCH)
# =============================================================================
MERID_ENABLE_CHAINLINK=true
MERID_ENABLE_AUGUR=false
MERID_ENABLE_NEWS_AGENT=true
MERID_ENABLE_WHALE_INTEL=true
MERID_ENABLE_POLYMARKET=true
MERID_CONSENSUS_THRESHOLD=0.66
MERID_CONFIDENCE_FLOOR=0.40

MERID_MINING_DIFFICULTY=4
MERID_MIN_CONFIDENCE_THRESHOLD=0.70

WHALE_TRACKING_ENABLED=true
WHALE_THRESHOLD_USD=1000000
LIQUIDATION_MONITORING_ENABLED=true
ONCHAIN_ANALYTICS_ENABLED=true

# =============================================================================
# MARL & SWARM INTELLIGENCE
# =============================================================================
MARL_ALGORITHM=COMA
MARL_LEARNING_RATE=0.0003
MARL_BATCH_SIZE=32
MARL_DEVICE=cpu

PSO_PARTICLES=20
PSO_ITERATIONS=100

MAX_AGENT_POPULATION=12
AGENT_SPAWN_THRESHOLD=0.60
AGENT_STALE_SCORE=0.35

# =============================================================================
# OPTIONAL ORCHESTRATION
# =============================================================================
AIRFLOW_HOME=/path/to/airflow
AIRFLOW_DAGS_FOLDER=/path/to/merid/dags
RAY_NUM_CPUS=4
RAY_NUM_GPUS=0
RAY_OBJECT_STORE_MEMORY=2000000000

# =============================================================================
# CONTACT & BRANDING
# =============================================================================
MERID_TWITTER=@MERIDonX
MERID_TELEGRAM=https://t.me/MaxExtractoor
MERID_CONTACT_EMAIL=your_contact_email
