# .env.example - MERID Master Environment File Template
# Location: C:\Dev\MERID\.env.example
# Copy this to .env and fill in your actual values
# NEVER commit .env to git! Add to .gitignore

# =============================================================================
# CORE LOCAL SYSTEM
# =============================================================================
MERID_ENV=production
MERID_LOG_LEVEL=INFO
MERID_DEV_ALLOW_WS=true

# =============================================================================
# LIVE-ONLY MODE SETTINGS
# =============================================================================
MERID_USE_MOCK_ARB_DATA=false
MERID_USE_DEMO_TRADES=false
MERID_USE_SAMPLE_DATA=false
MERID_USE_MOCK_STREAMS=false

MERID_ENABLE_LIVE_PRICE_FEEDS=true
MERID_ENABLE_REAL_PREDICTION_MARKETS=true
MERID_ENABLE_REAL_SOLANA_WS=true
MERID_ENABLE_REAL_NEWS=true

# =============================================================================
# EMAIL NOTIFICATIONS
# =============================================================================
MY_EMAIL=your_email@gmail.com
APP_PASSWORD=your_app_password
RECEIVER_EMAIL=your_receiver@outlook.com

# =============================================================================
# TELEGRAM ALERTS
# =============================================================================
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# =============================================================================
# SUPABASE
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
PUBLISHABLE_KEY=your_publishable_key

# =============================================================================
# NEO4J LOCAL GRAPH DB
# =============================================================================
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# =============================================================================
# MARKET DATA APIs
# =============================================================================
MESSARI_API_KEY=your_messari_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
POLYGON_API_KEY=your_polygon_api_key
NEWS_API_KEY=your_news_api_key
SERPER_API_KEY=your_serper_api_key
FRED_API_KEY=your_fred_api_key
FINNHUB_API_KEY=your_finnhub_api_key
THE_GRAPH_API_KEY=your_graph_api_key

# =============================================================================
# BLOCKCHAIN & SOLANA
# =============================================================================
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_key

# =============================================================================
# AI & MACHINE LEARNING
# =============================================================================
HUGGINGFACE_API_KEY=your_huggingface_key
CLAUDE_SONNET_4=your_claude_api_key
DEEPSEEK_API_KEY=your_deepseek_key
OLLAMA_API_KEY=your_ollama_key
OPENAI_API_KEY=your_openai_key
OPEN_ROUTER_API_KEY=your_openrouter_key

# =============================================================================
# DATABASE & INFRASTRUCTURE
# =============================================================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=your_app
RAILWAY_API_TOKEN=your_railway_token
REDIS_URL=redis://username:password@host:port

# =============================================================================
# COMMUNICATION & NOTIFICATIONS
# =============================================================================
TWILIO_SID=your_twilio_sid
TWILIO_TOKEN=your_twilio_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_sid
TWILIO_PHONE=+15551234567

# =============================================================================
# X (TWITTER) API
# =============================================================================
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_BEARER_TOKEN=your_x_bearer_token
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret

# =============================================================================
# LEGACY (Alpaca/IBKR) — ignored by Kalshi production
# These vars are NOT used in production Kalshi trading. Kept for archival
# purposes only. In a pure Kalshi deployment these can be left unset.
# =============================================================================
# PAPER TRADING (ALPACA) — LEGACY, not used in Kalshi production
# =============================================================================
PAPER_BROKER=alpaca
PAPER_API_KEY=your_alpaca_paper_key
PAPER_API_SECRET=your_alpaca_paper_secret
PAPER_API_BASE=https://paper-api.alpaca.markets
PAPER_DATA_SOURCE=alpaca

# Alpaca credentials — LEGACY, not used in Kalshi production
MERID_ALPACA_API_KEY=your_alpaca_paper_key
MERID_ALPACA_API_SECRET=your_alpaca_paper_secret
ALPACA_API_KEY=your_alpaca_paper_key
ALPACA_API_SECRET=your_alpaca_paper_secret

# =============================================================================
# CEX ADAPTERS
# =============================================================================
# Binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Coinbase Advanced Trade (MERID_ prefix preferred, legacy also supported)
MERID_COINBASE_API_KEY=your_coinbase_api_key
MERID_COINBASE_API_SECRET=your_coinbase_api_secret
COINBASE_API_KEY=your_coinbase_api_key
COINBASE_API_SECRET=your_coinbase_api_secret

# Kraken
KRAKEN_API_KEY=your_kraken_api_key
KRAKE_PRIVATE_KEY=your_kraken_private_key

# OKX
OKX_API_KEY=your_okx_api_key
OKX_SECRET_KEY=your_okx_secret_key
OKX_API_KEY_NAME=MERID
OKX_PERMISSIONS=Read

# Bybit (optional)
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret

# =============================================================================
# PREDICTION MARKETS
# =============================================================================
# Kalshi RSA Authentication (preferred method)
KALSHI_API_KEY_ID=your_kalshi_api_key_id
KALSHI_PRIVATE_KEY_PATH=your_kalshi_private_key_path
# KALSHI_PRIVATE_KEY_PEM=  # Alternative: paste raw PEM string

# Kalshi Email/Password Authentication (fallback if RSA not available)
# KALSHI_EMAIL=your_kalshi_email@example.com
# KALSHI_PASSWORD=your_kalshi_password

# Kalshi API configuration
KALSHI_USE_DEMO=false
# KALSHI_API_HOST=  # Optional: override API host (e.g., for elections endpoint)

# Kalshi environment: 'live' enforces CFB RTI health gate; 'paper'/'demo' bypass it
KALSHI_ENV=live

# =============================================================================
# GLOBAL TRADING MODE (production Kalshi trading system)
# =============================================================================
# Single canonical trade-mode for the entire process.
#   mock  — no real orders; all fills are synthetic
#   paper — real market data, simulated execution
#   live  — real orders with real money (requires MERID_ALLOW_LIVE_TRADES=true)
MERID_TRADE_MODE=live
MERID_TRADING_MODE=live

# Must be true for any transition to LIVE mode (additional interlock).
MERID_ALLOW_LIVE_TRADES=true

# Explicit unlock for live trading across all modules.
MERID_LIVE_TRADING_UNLOCKED=true

# =============================================================================
# AgentGrid Trading Mode (production Kalshi trading system)
# =============================================================================
# Mode for the AgentGrid prediction-market trading system.
#   sim   — simulated fills only, no Kalshi API calls
#   paper — real market data from Kalshi, simulated execution
#   live  — real orders placed on Kalshi (requires MERID_PM_LIVE_ENABLED=true)
MERID_PM_TRADING_MODE=live

# Explicit unlock for live AgentGrid trading.
# Both MERID_PM_TRADING_MODE=live AND MERID_PM_LIVE_ENABLED=true must be set
# for real orders to be submitted.  All 35 agents are force-promoted to LIVE at
# startup when both flags are present.
MERID_PM_LIVE_ENABLED=true

# Kalshi Paper Trading Configuration (only active when MERID_PM_TRADING_MODE=paper)
# MERID_KALSHI_PAPER_SLIPPAGE_BPS=8.0
# MERID_KALSHI_PAPER_PARTIAL_FILL_PROB=0.35
# MERID_KALSHI_PAPER_MIN_FILL_RATIO=0.4

# =============================================================================
# Continuous Trader Configuration (config/kalshi_ct_env.py)
# =============================================================================

# AUDIT-01: REQUIRED in live mode — session bankroll in cents (e.g. 50000 = $500).
# CT will refuse to start without this value when not in dry-run mode.
# KALSHI_TRADER_BANKROLL=50000

# AUDIT-12: Minimum bankroll floor in cents (default 100 = $1).
# CT refuses to start if bankroll is below this value.
# Safe default: 100.  Increase for production; lower only for unit tests.
# MERID_CT_BANKROLL_MIN_CENTS=100

# AUDIT-14: Set to 'true' to skip credential checks and live order submission.
# Useful for unit tests and paper-trading exploratory runs.
# MERID_CT_DRY_RUN=false

# AUDIT-15: Set to 'true' to enable smoke-test mode.
# CT will raise a RuntimeError on start if any live-mode flag is also set.
# MERID_SMOKE_TEST=false

# AUDIT-02: Maximum candidates to pass per (asset, timeframe) pair.
# Safe default: 5.  Increase only if catalog quality is high.
# MERID_CT_MAX_CANDIDATES=5

# AUDIT-03: Maximum bid/ask spread in cents.  Candidates with wider spreads are
# rejected.  ⚠️ Setting this too high increases slippage risk.
# Safe default: 12.  Recommended production range: 8–15.
# MERID_CT_MAX_SPREAD_CENTS=12

# AUDIT-04: Minimum trade volume threshold.  Candidates below this are rejected.
# Safe default: 50.  Lower values allow illiquid markets.
# MERID_CT_MIN_VOLUME=50

# AUDIT-06: Hard cap on the number of contracts per order.  0 = no cap.
# ⚠️ Setting to 0 with high bankroll can create large concentrated positions.
# Recommended production value: 50–200 depending on bankroll size.
# MERID_CT_MAX_POSITION_CONTRACTS=0

# AUDIT-07: Multiplier applied to the Kelly-sized notional (0 < value ≤ 2).
# Use values < 1.0 to scale back exposure (recommended for new deployments).
# ⚠️ Values > 1.0 are DANGEROUS — they amplify Kelly sizing beyond the optimal.
# Safe default: 1.0.  Recommended new-deployment value: 0.25–0.5.
# MERID_CT_EXPOSURE_MULTIPLIER=1.0

# AUDIT-08: Minimum seconds between consecutive trades for the same asset.
# 0 = cooldown disabled (allows back-to-back trades on the same asset).
# ⚠️ Setting to 0 in live mode can cause rapid-fire orders during volatile markets.
# Safe default: 0.  Recommended production value: 60–300.
# MERID_CT_COOLDOWN_SECONDS=0

# AUDIT-09: Per-(asset, timeframe) minimum edge overrides.
# Format: KALSHI_CT_MIN_EDGE_{ASSET}_{TIMEFRAME}  (value = decimal fraction, e.g. 0.005)
# Examples:
# KALSHI_CT_MIN_EDGE_BTC_15M=0.005
# KALSHI_CT_MIN_EDGE_ETH_1H=0.010
# KALSHI_CT_MIN_EDGE_SOL_DAILY=0.015

# AUDIT-11: Stagger delay in seconds between agent starts in the agent grid.
# Prevents thundering-herd on the Kalshi API at startup.
# ⚠️ Setting to 0 removes the stagger — safe for tests, risky in production with
# many agents starting simultaneously.
# Safe default: 0.5.  Production range: 0.3–1.0.
# MERID_AGENT_STAGGER_SECONDS=0.5

# AUDIT-22: Per-asset volatility anchor.
# Default: each asset uses its own vol (self-anchor).
# Set to another asset to use that asset's vol instead (e.g. use BTC vol for DOGE).
# KALSHI_CT_VOL_ANCHOR_BTC=BTC
# KALSHI_CT_VOL_ANCHOR_ETH=ETH
# KALSHI_CT_VOL_ANCHOR_SOL=SOL
# KALSHI_CT_VOL_ANCHOR_XRP=XRP
# KALSHI_CT_VOL_ANCHOR_DOGE=DOGE

# Continuous Trader core knobs
# MERID_GROUP_NOTIONAL_CAP=50.0      # Max $ per group (asset × timeframe)
# MERID_MIN_CONFIDENCE=0.55          # Minimum confidence to trade
# MERID_BANKROLL_FRACTION=0.01       # 1% of bankroll per trade
# MERID_MAX_YES_PRICE=0.50           # Hard cap on YES contract price
# MERID_KELLY_FRACTION=0.25          # Fractional-Kelly multiplier
# MERID_MIN_EDGE=0.02                # Global fallback min edge (fraction)
# KALSHI_CT_EDGE_PROFILE=initial_live  # 'initial_live' (permissive) or 'production'

# AUDIT-10: Swarm degraded-mode limits for KalshiTradingAgent.
# MERID_AGENT_MAX_SOLO_SECONDS=300   # Seconds of swarm silence before solo trading
# MERID_AGENT_MAX_SOLO_TRADES=3      # Max consecutive solo trades while degraded

# AUDIT-17: Social broadcaster per-asset cooldown.
# MERID_BROADCASTER_COOLDOWN_SECONDS=300  # Seconds between posts for same asset/tf

# AUDIT-21: Spot price staleness limit for last-known fallback.
# Must be ≤ MERID_PM_MAX_SPOT_AGE_SECONDS (default 90s) to avoid a window where
# the cache reports a price but the PM gate considers it stale.
# Code default: 60s (see data/live_price_feed.py).
# MERID_SPOT_MAX_STALENESS_SECONDS=60    # Max age of cached spot price (seconds)

# Order-router snapshot staleness gate: reject live OrderIntents whose snapshot
# is older than this threshold (seconds).  Code default: 30s.
# MERID_SNAPSHOT_STALENESS_SECONDS=30

# =============================================================================
# CFB RTI (CF Benchmarks Real-Time Index) — required for live Kalshi trading
# =============================================================================
# Adapter: 'live' polls the real CF Benchmarks API; 'simulation' uses synthetic ticks
MERID_CFB_RTI_ADAPTER=live

# Set to 1 to force simulation mode (overrides MERID_CFB_RTI_ADAPTER)
MERID_CFB_RTI_SIMULATE=0

# Live endpoint — obtain a licensed URL from https://docs.cfbenchmarks.com/api/
# Required when MERID_CFB_RTI_ADAPTER=live
# MERID_CFB_RTI_POLL_URL=https://api.cfbenchmarks.com/v1/rtis/BRTI/value

# CF Benchmarks API key (sent as X-Api-Key header)
# CFB_API_KEY=your_cfbenchmarks_api_key

# Set to 1 to bypass the CFB RTI safety gate (non-prod only — acknowledged no-data)
MERID_ALLOW_NULL_CFB=0

# =============================================================================
# ANALYTICS & INTELLIGENCE
# =============================================================================
NANSEN_API_KEY=your_nansen_api_key
MERID_COINGLASS_API_KEY=your_coinglass_api_key
MERID_NANSEN_API_KEY=your_nansen_api_key
MERID_ARKHAM_API_KEY=your_arkham_api_key
MERID_GLASSNODE_API_KEY=your_glassnode_api_key
MERID_SANTIMENT_API_KEY=your_santiment_api_key

# =============================================================================
# LEGACY (Alpaca/IBKR) — IBKR PAPER — ignored by Kalshi production
# =============================================================================
IBKR_PAPER_TRADING_USERNAME=your_ibkr_username
IBKR_PAPER_TRADING_ACCOUNT_NUMBER=your_ibkr_account

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
MERID_DASHBOARD_API_KEY=your_dashboard_api_key
JWT_SECRET_KEY=your_jwt_secret_key
SESSION_SECRET=your_session_secret

# =============================================================================
# CORS
# =============================================================================
MERID_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# =============================================================================
# FEATURE FLAGS (SIM / RESEARCH)
# =============================================================================
MERID_ENABLE_CHAINLINK=true
MERID_ENABLE_AUGUR=false
MERID_ENABLE_NEWS_AGENT=true
MERID_ENABLE_WHALE_INTEL=true
MERID_ENABLE_POLYMARKET=true
MERID_CONSENSUS_THRESHOLD=0.66
MERID_CONFIDENCE_FLOOR=0.40

MERID_MINING_DIFFICULTY=4
MERID_MIN_CONFIDENCE_THRESHOLD=0.70

WHALE_TRACKING_ENABLED=true
WHALE_THRESHOLD_USD=1000000
LIQUIDATION_MONITORING_ENABLED=true
ONCHAIN_ANALYTICS_ENABLED=true

# =============================================================================
# MARL & SWARM INTELLIGENCE
# =============================================================================
MARL_ALGORITHM=COMA
MARL_LEARNING_RATE=0.0003
MARL_BATCH_SIZE=32
MARL_DEVICE=cpu

PSO_PARTICLES=20
PSO_ITERATIONS=100

MAX_AGENT_POPULATION=12
AGENT_SPAWN_THRESHOLD=0.60
AGENT_STALE_SCORE=0.35

# =============================================================================
# OPTIONAL ORCHESTRATION
# =============================================================================
AIRFLOW_HOME=/path/to/airflow
AIRFLOW_DAGS_FOLDER=/path/to/merid/dags
RAY_NUM_CPUS=4
RAY_NUM_GPUS=0
RAY_OBJECT_STORE_MEMORY=2000000000

# =============================================================================
# CONTACT & BRANDING
# =============================================================================
MERID_TWITTER=@MERIDonX
MERID_TELEGRAM=https://t.me/MaxExtractoor
MERID_CONTACT_EMAIL=your_contact_email
